// Configurazione del Worker "ufotizio-site" (deploy automatico da Cloudflare
// a ogni push su main, con "npx wrangler deploy").
{
  "name": "ufotizio-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Le pagine passano dal Worker, che le scrive nella lingua dell'indirizzo
    // (src/pagine.js); i file di /assets/ e /account/ no.
    "run_worker_first": ["/*", "!/assets/*", "!/account/*"],
    "not_found_handling": "404-page"
  },
  "r2_buckets": [{ "binding": "GAMES", "bucket_name": "ufotizio-games" }],
  // Modulo Contattami (src/contatti.js): le email partono con Cloudflare
  // Email Routing (attivo sul dominio, con l'indirizzo di destinazione
  // verificato) e solo verso quell'indirizzo. Il binding si aggiunge quando
  // Email Routing è attivo, così (senza, /api/contatti risponde 503):
  //   "send_email": [{ "name": "EMAIL", "destination_address": "fabriziodamore1984@gmail.com" }],
  // Il segreto di Turnstile non sta qui: si imposta con
  // "npx wrangler secret put TURNSTILE_SECRET".
  "vars": { "EMAIL_DESTINATARIO": "fabriziodamore1984@gmail.com" },
  // Al massimo 3 invii al minuto per indirizzo IP.
  "ratelimits": [{ "name": "LIMITE_CONTATTI", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
